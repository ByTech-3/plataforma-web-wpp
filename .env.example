# ============================================================================
#  app-web — variáveis de ambiente
#
#  Copie este arquivo para `.env.local` e preencha com os valores do seu
#  projeto Supabase (Dashboard > Project Settings > API).
#
#  `.env.local` está no .gitignore (regra `.env*`) e NUNCA deve ser commitado.
#  Este `.env.example` é o único arquivo de env que vai para o repositório,
#  e por isso não contém valores reais.
# ============================================================================

# URL do projeto Supabase. Ex.: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave `anon` (pública). É segura no browser SOMENTE porque a RLS da Fase 2
# está ativa — ela sozinha não dá acesso a dado nenhum.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ A chave `service_role` NUNCA entra aqui nem em nenhuma variável
#    NEXT_PUBLIC_*. Ela ignora toda a RLS e vazaria os dados de TODAS as
#    empresas clientes se fosse para o bundle do browser.
